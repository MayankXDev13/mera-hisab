# Database — Supabase shared transaction-mode pooler (IPv4-only), used by app and drizzle-kit
# postgres.js client runs with prepare:false (required for transaction pool mode)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# API
PORT=3001
API_URL=http://localhost:3001

# Web app origin (CORS + better-auth trusted origins)
WEB_URL=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Social login (optional — leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- apps/web (Next.js) ----
# API base URL the browser talks to
NEXT_PUBLIC_API_URL=http://localhost:3001



